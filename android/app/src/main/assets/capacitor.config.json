{
	"appId": "com.kidneycareplus.app",
	"appName": "KidneyCare+",
	"webDir": "out",
	"server": {
		"androidScheme": "https",
		"cleartext": false
	},
	"ios": {
		"contentInset": "automatic",
		"backgroundColor": "#f0f9ff",
		"preferredContentMode": "mobile"
	},
	"android": {
		"allowMixedContent": false,
		"backgroundColor": "#f0f9ff"
	},
	"plugins": {
		"PushNotifications": {
			"presentationOptions": [
				"badge",
				"sound",
				"alert"
			]
		},
		"LocalNotifications": {
			"smallIcon": "ic_stat_icon",
			"iconColor": "#6366f1"
		}
	}
}
